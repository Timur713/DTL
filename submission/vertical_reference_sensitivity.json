{
  "controls_unchanged": true,
  "experiment": "configured_alternative_vertical_threshold",
  "experimental_rules_sha256": "d9fb00a58387cfd16f22c402883a50f5af58d562b5c77ea8a554b20ce5cfa381",
  "original_rules_sha256": "0c8c813b2d183823fd6c51714bc3aeb64b837fd4c306d81a087edd2d09df88d3",
  "rules": {
    "assumptions": {
      "aircraft_destination": "original_baseline_position_at_duration_s",
      "coordinate_system": "local_cartesian_east_north_geometric_altitude",
      "excluded": [
        "maneuver_planning",
        "wake_turbulence",
        "6DOF",
        "wing_geometry",
        "terrain",
        "weather",
        "earth_curvature",
        "regulatory_compliance_claim"
      ],
      "motion": "p(t) = p0 + v*t for all aircraft and threat over [0,1200]",
      "target_motion": "static_xyz",
      "threat_after_target_xy": "continue_same_velocity_and_altitude",
      "unknown": [
        "aircraft_type",
        "mass",
        "flight_envelope",
        "equipment",
        "RVSM_approval",
        "pressure_altitude",
        "navigation_accuracy",
        "surveillance_service",
        "wind",
        "threat_effects"
      ],
      "vehicle_geometry": "point_with_protected_volume"
    },
    "comparison": {
      "distance_epsilon_m": 1e-07,
      "distance_violation_operator": "strict_less_than",
      "epsilon_is_physical_buffer": false,
      "epsilon_policy": "numerical_root_residual_only_never_expand_or_shrink_safety_thresholds",
      "equality_is_safe": true,
      "horizon_closed": true,
      "method": "continuous_affine_motion_quadratic_intervals",
      "time_epsilon_s": 1e-09
    },
    "defaults": {
      "mode_id": "nominal",
      "profile_id": "metric",
      "variant_id": "base"
    },
    "delays": {
      "communication_s": 0,
      "execution_s": 0,
      "observation_s": 0,
      "positive_delays_supported": false
    },
    "duration_s": 1200,
    "modes": [
      {
        "error_bounds": {
          "position_horizontal_m": 0,
          "position_vertical_m": 0,
          "velocity_horizontal_mps": 0,
          "velocity_vertical_mps": 0
        },
        "id": "nominal",
        "label": "Exact initial states",
        "severity": "nominal_violation"
      },
      {
        "error_bounds": {
          "position_horizontal_m": 100,
          "position_vertical_m": 20,
          "velocity_horizontal_mps": 1,
          "velocity_vertical_mps": 0.1
        },
        "id": "bounded_stress",
        "label": "Bounded errors: loss of guarantee",
        "severity": "possible_violation"
      }
    ],
    "motion_limits": {
      "aircraft": {
        "bank_abs_max_deg": 25,
        "gravity_mps2": 9.80665,
        "horizontal_acceleration_abs_max_mps2": 0.5,
        "horizontal_acceleration_definition": "absolute_derivative_of_horizontal_speed_not_total_horizontal_vector_acceleration",
        "horizontal_speed_max_mps": 260,
        "horizontal_speed_min_mps": 200,
        "turn_rate_formula": "g * tan(bank_abs_max_deg * pi / 180) / horizontal_speed_mps",
        "turn_rate_unit": "rad/s",
        "vertical_acceleration_abs_max_mps2": 0.5,
        "vertical_speed_abs_max_mps": 15,
        "wind_mps": [
          0,
          0,
          0
        ]
      },
      "baseline_acceleration_mps2": [
        0,
        0,
        0
      ],
      "baseline_turn_rate_radps": 0,
      "checks_apply_to": "all_admissible_constant_velocity_aircraft_trajectories_in_selected_mode",
      "maneuvers_implemented": false,
      "model": "generic_jet_assumption",
      "stress_horizontal_speed_interval": "[max(0, norm(v_xy) - velocity_horizontal_mps), norm(v_xy) + velocity_horizontal_mps]",
      "stress_vertical_speed_interval": "[vz - velocity_vertical_mps, vz + velocity_vertical_mps]",
      "velocity_error_constant_over_horizon": true
    },
    "profiles": [
      {
        "horizontal_m": 9260,
