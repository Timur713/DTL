    "uncertainty": {
      "applies_to": [
        "aircraft",
        "threat"
      ],
      "horizontal_formula": "position_horizontal_m + velocity_horizontal_mps * t",
      "horizontal_set": "euclidean_disk",
      "interpretation": "deterministic_bounds_not_probabilities",
      "pair_combination": "sum_of_individual_bounds",
      "reference_time_s": 0,
      "reset_on_frame": false,
      "sphere_error_bound": "horizontal_plus_vertical",
      "target_exact": true,
      "vertical_formula": "position_vertical_m + velocity_vertical_mps * t",
      "vertical_set": "symmetric_interval"
    },
    "units": "SI: m, s, m/s, m/s^2; angles explicitly labelled",
    "zones": {
      "aircraft": {
        "shape": "relative_cylinder",
        "thresholds_from": "profile",
        "violation": "horizontal_distance < horizontal_m AND absolute_vertical_distance < vertical_m"
      },
      "altitude": {
        "allowed_boundary_inclusive": true,
        "applies_to": "aircraft",
        "bounds_from": "scenario.airspace",
        "max_key": "alt_max_m",
        "min_key": "alt_min_m",
        "stress_rule": "z - e_z < alt_min_m OR z + e_z > alt_max_m"
      },
      "horizontal_airspace": {
        "bounds_from": "scenario.airspace",
        "retain_objects_outside": true,
        "safety_constraint": false
      },
      "target": {
        "center_alt_m": 0,
        "radius_m": 5000,
        "shape": "sphere",
        "stress_expansion": "e_h_aircraft + e_z_aircraft",
        "violation": "distance_3d < effective_radius"
      },
      "threat": {
        "radius_m": 5000,
        "shape": "sphere",
        "stress_expansion": "e_h_aircraft + e_z_aircraft + e_h_threat + e_z_threat",
        "violation": "distance_3d < effective_radius"
      }
    }
